{
  "seed": 42,
  "data": {
    "val_size": 0.1,
    "batch_size": 64
  },
  "model": {
    "type": "mlp",
    "layers": [
      {"type": "dense", "in": 784, "out": 128, "init": "he", "activation": "relu"},
      {"type": "dense", "in": 128, "out": 10, "init": "xavier", "activation": "softmax"}
    ]
  },
  "training": {
    "epochs": 20,
    "optimizer": "sgd",
    "learning_rate": 0.1,
    "momentum": 0.9,
    "l2": 0.0001,
    "early_stopping_patience": 5
  }
}